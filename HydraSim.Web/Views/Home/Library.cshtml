@model IEnumerable<HydraSim.Domain.Simulation.HydraulicSimulation>

@{
    ViewData["Title"] = "Library";
}

<link rel="stylesheet" href="~/css/Library.css" asp-append-version="true" />

<div class="grid-container">
    @foreach (var sim in Model)
    {
        <a asp-controller="Simulation" asp-action="Run" asp-route-id="@sim.Id">
            <div class="grid-item">
                <img src="@sim.ImagePath" />
                <h3>@sim.Name</h3>
                <p>@sim.Description</p>
            </div>
        </a>
    }
</div>
